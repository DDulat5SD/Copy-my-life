# CopyMyLife environment variables
#
# Copy to .env for local development (.env is git-ignored) and fill in your own values.
# Every value below is a placeholder. Never commit real credentials.
# On Railway, set these as service variables per environment (staging and production
# must each have their own secrets).
#
# Spring Boot maps UPPER_SNAKE_CASE variables onto properties, e.g. AI_MATCHING_URL -> ai.matching.url.

# ---------------------------------------------------------------------------
# Backend (Spring Boot, src/main/resources/application.properties)
# ---------------------------------------------------------------------------

# HTTP port. Railway injects this automatically. Default: 8080
PORT=8080

# Public URL of this deployment, used in links sent by email. Default: http://localhost:8080
APP_BASE_URL=http://localhost:8080

# PostgreSQL. DB_URL defaults to jdbc:postgresql://localhost:5432/copymylife
DB_URL=jdbc:postgresql://localhost:5432/copymylife
DB_USERNAME=copymylife
DB_PASSWORD=change-me

# JWT signing key: REQUIRED, Base64-encoded, at least 32 bytes (256 bits) once decoded.
# Generate one with: openssl rand -base64 64 | tr -d '\r\n'
# (OpenSSL wraps its output; on Windows the lines end in \r\n, and a stray \r breaks login.)
JWT_SECRET=replace-with-base64-output-of-openssl-rand-base64-64

# SMTP (Gmail) used by spring.mail: REQUIRED at startup
MAIL_USERNAME=your-address@example.com
MAIL_PASSWORD=your-app-password
# Optional: point SMTP at a host that does not exist to make sure nothing is sent (staging).
# SPRING_MAIL_HOST=mail-disabled.invalid

# Mailjet transactional email: REQUIRED at startup
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_SENDER_EMAIL=no-reply@example.com

# AI service (copymylife-ai). Optional: without it, AI matching/assistant features degrade gracefully.
# On Railway use the private-network address of the AI service.
AI_MATCHING_URL=http://127.0.0.1:8001
# Must equal CML_AI_TOKEN on the AI service.
AI_MATCHING_TOKEN=replace-with-a-long-random-token
AI_MATCHING_TIMEOUT_SECONDS=20
AI_ASSISTANT_TIMEOUT_SECONDS=10

# Optional overrides
# APP_UPLOAD_DIR=uploads
# APP_TRACKING_DEFAULT_TIME_ZONE=Asia/Almaty

# ---------------------------------------------------------------------------
# AI service (Python, ai/)
# ---------------------------------------------------------------------------

# Shared token checked in the X-AI-Token header. Must equal AI_MATCHING_TOKEN on the backend.
# The Docker image refuses to start without it.
CML_AI_TOKEN=replace-with-a-long-random-token
# 1 accepts non-local clients. The Docker image already sets 1; leave 0 for local runs.
CML_AI_ALLOW_REMOTE=0
# Model directory. The Docker image sets /models/multilingual-minilm.
# CML_AI_MODEL_DIR=ai/models/multilingual-minilm
# CML_AI_THREADS=1
# CML_AI_MAX_BODY_BYTES=1000000

# ---------------------------------------------------------------------------
# Tests (only needed to run the integration test suite)
# ---------------------------------------------------------------------------

# Integration tests run only when this points to a local database whose name ends in _test.
TEST_DB_URL=jdbc:postgresql://localhost:5432/copymylife_test
TEST_DB_USERNAME=test
TEST_DB_PASSWORD=test
# Optional: browser checks and the Python AI integration test
# CHROME_BIN=
# AI_PYTHON=
